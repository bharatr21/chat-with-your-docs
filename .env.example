# ===========================================
# RAG Chat Application - Environment Variables
# ===========================================

# Required: Default HuggingFace key (free tier for all users)
# This is used as fallback when users don't provide their own keys
DEFAULT_HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# Optional: User-provided API keys
# These enable additional model options when set
# ===========================================
HF_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ===========================================
# Database Configuration
# ===========================================
CHROMA_DB_PATH=./chroma_db

# ===========================================
# Session Storage
# ===========================================
# Options: "file" (uses .sessions folder) or "supabase"
SESSION_STORAGE=file

# ===========================================
# Supabase (Future - for production)
# ===========================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
